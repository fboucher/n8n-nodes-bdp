{
  "name": "BDP daily measurement point history (template)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "bdp-schedule",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "measurementValue",
        "operation": "getHistorical",
        "measurementId": {
          "mode": "id",
          "value": "REPLACE_WITH_MEASUREMENT_POINT_ID"
        },
        "start": "={{$now.minus({days: 1}).toISO()}}",
        "end": "={{$now.toISO()}}",
        "returnAll": true
      },
      "id": "bdp-point-history",
      "name": "Read Previous 24 Hours",
      "type": "n8n-nodes-bdp.bdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "bdpOAuth2Api": {
          "name": "Bind your BDP credential"
        }
      }
    },
    {
      "parameters": {},
      "id": "bdp-downstream",
      "name": "Use Native Records",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "content": "Before activating: bind a BDP Community OAuth2 API credential and replace the measurement point ID. The ID can be entered directly; a building or point-discovery step is not required. This template reads the previous 24 hours once per day and returns all pages. Scheduled runs are not snapshots or exactly-once reads; account for overlaps or gaps if your workflow requires deduplication.",
        "height": 220,
        "width": 660
      },
      "id": "bdp-point-guide",
      "name": "Setup and Limits",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 40]
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [[{ "node": "Read Previous 24 Hours", "type": "main", "index": 0 }]]
    },
    "Read Previous 24 Hours": {
      "main": [[{ "node": "Use Native Records", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "00000000-0000-4000-8000-000000000001"
}
