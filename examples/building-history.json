{
  "name": "BDP daily building history (template)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "bdp-building-schedule",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "building",
        "operation": "getHistorical",
        "buildingId": {
          "mode": "id",
          "value": "REPLACE_WITH_BUILDING_ID"
        },
        "start": "={{$now.minus({days: 1}).toISO()}}",
        "end": "={{$now.toISO()}}",
        "returnAll": true
      },
      "id": "bdp-building-history",
      "name": "Read Previous 24 Hours",
      "type": "n8n-nodes-bdp.bdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "bdpOAuth2Api": {
          "name": "Bind your BDP credential"
        }
      }
    },
    {
      "parameters": {},
      "id": "bdp-building-downstream",
      "name": "Use Native Records",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "content": "Before activating: bind a BDP Community OAuth2 API credential and replace the building ID. This template reads the previous 24 hours once per day and returns all pages. Confirm access to the selected building. Scheduled runs are not snapshots or exactly-once reads; account for overlaps or gaps if your workflow requires deduplication.",
        "height": 200,
        "width": 620
      },
      "id": "bdp-building-guide",
      "name": "Setup and Limits",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 40]
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [[{ "node": "Read Previous 24 Hours", "type": "main", "index": 0 }]]
    },
    "Read Previous 24 Hours": {
      "main": [[{ "node": "Use Native Records", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "00000000-0000-4000-8000-000000000002"
}
