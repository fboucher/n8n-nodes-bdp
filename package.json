{
	"name": "n8n-nodes-bdp-beta",
	"version": "0.1.0",
	"description": "Beta version of the official EcoStruxure Building Data Platform nodes for n8n",
	"license": "MIT",
	"homepage": "https://github.com/fboucher/n8n-nodes-bdp#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"schneider-electric",
		"building-data-platform",
		"bdp",
		"smart-building",
		"iot",
		"energy-management",
		"building-automation"
	],
	"author": {
		"name": "Frank Boucher",
		"email": "frank.boucher@se.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fboucher/n8n-nodes-bdp.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/fboucher/n8n-nodes-bdp/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs",
		"test:docker": "npm run build && node tests/docker-smoke.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"examples/local",
		"examples/npm",
		"examples/README.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/BdpOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bdp/Bdp.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.56.4",
		"eslint": "9.29.0",
		"prettier": "3.9.10",
		"release-it": "21.1.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"graphql": "^16.15.0"
	}
}
